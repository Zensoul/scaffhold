generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(uuid())
  role              Role
  fullName          String
  phoneE164         String?   @unique
  email             String?   @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  preferredLanguage Language  @default(EN)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  lastLoginAt       DateTime?

  accounts     Account[]
  authSessions Session_NextAuth[]

  studentProfile         StudentProfile?      @relation("StudentUser")
  taughtStudents         StudentProfile[]     @relation("TeacherStudents")
  parentChildren         StudentProfile[]     @relation("ParentChildren")
  parentInvites          StudentInvite[]      @relation("ParentInvites")
  teacherObservations    TeacherObservation[] @relation("TeacherObservations")
  observedStudents       TeacherObservation[] @relation("ObservedStudents")
  reviewedProblems       Problem[]
  reviewedDrafts         ProblemDraft[]
  reviewedDiagrams       ProblemDiagram[]
  parentSummaries        ParentSummary[]      @relation("ParentSummaries")
  studentSummaries       ParentSummary[]      @relation("StudentParentSummaries")
  chapterAssignmentsMade ChapterAssignment[]  @relation("ChapterAssigner")

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session_NextAuth {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Role {
  student
  parent
  teacher
}

enum Language {
  EN
  HI
  TA
  TE
  KN
  ML
}

model StudentProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  grade              Int
  board              Board     @default(CBSE)
  schoolName         String?
  teacherId          String?
  parentId           String?
  enrollmentDate     DateTime  @default(now())
  dpdpConsentGiven   Boolean   @default(false)
  dpdpConsentAt      DateTime?
  dpdpConsentVersion String?
  isActive           Boolean   @default(true)

  user               User                @relation("StudentUser", fields: [userId], references: [id])
  teacher            User?               @relation("TeacherStudents", fields: [teacherId], references: [id])
  parent             User?               @relation("ParentChildren", fields: [parentId], references: [id])
  chapterAssignments ChapterAssignment[]
  invite             StudentInvite?
  scaffoldingLevels  ScaffoldingLevel[]
  sessions           Session[]

  @@map("student_profiles")
}

model StudentInvite {
  id                 String    @id @default(uuid())
  parentId           String
  childFullName      String
  childGrade         Int
  inviteToken        String    @unique @default(uuid())
  consentGiven       Boolean   @default(false)
  consentGivenAt     DateTime?
  consentTextVersion String?
  usedAt             DateTime?
  studentProfileId   String?   @unique
  createdAt          DateTime  @default(now())
  expiresAt          DateTime

  parent         User            @relation("ParentInvites", fields: [parentId], references: [id])
  studentProfile StudentProfile? @relation(fields: [studentProfileId], references: [id])

  @@map("student_invites")
}

model FlaggedContent {
  id                String    @id @default(uuid())
  studentId         String
  sessionId         String?
  problemId         String?
  rawText           String
  moderationResult  Json
  category          String
  notifiedParentAt  DateTime?
  notifiedTeacherAt DateTime?
  reviewedAt        DateTime?
  reviewedBy        String?
  createdAt         DateTime  @default(now())

  @@index([studentId, createdAt])
  @@map("flagged_content")
}

model RevokedSession {
  id        String   @id @default(uuid())
  jti       String   @unique
  userId    String
  revokedAt DateTime @default(now())
  reason    String?

  @@index([jti])
  @@map("revoked_sessions")
}

enum Board {
  CBSE
  ICSE
}

model Subject {
  id       String      @id @default(uuid())
  name     SubjectName
  grade    Int
  board    Board       @default(CBSE)
  chapters Chapter[]

  @@unique([name, grade, board])
  @@map("subjects")
}

enum SubjectName {
  math
  physics
}

model Chapter {
  id               String  @id @default(uuid())
  subjectId        String
  name             String
  sequenceNumber   Int
  isActive         Boolean @default(true)
  syllabusYear     String?
  deletedSubtopics Json    @default("[]")

  subject            Subject              @relation(fields: [subjectId], references: [id])
  problems           Problem[]
  problemDrafts      ProblemDraft[]
  scaffoldingLevels  ScaffoldingLevel[]
  scaffoldingHistory ScaffoldingHistory[]
  sessions           Session[]
  chapterAssignments ChapterAssignment[]
  subtopics          Subtopic[]

  @@unique([subjectId, sequenceNumber])
  @@map("chapters")
}

model Subtopic {
  id             String   @id @default(uuid())
  chapterId      String
  name           String
  sequenceNumber Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  chapter       Chapter        @relation(fields: [chapterId], references: [id])
  problems      Problem[]
  problemDrafts ProblemDraft[]

  @@unique([chapterId, sequenceNumber])
  @@map("subtopics")
}

model ChapterAssignment {
  id         String   @id @default(uuid())
  studentId  String
  chapterId  String
  assignedBy String
  assignedAt DateTime @default(now())

  student  StudentProfile @relation(fields: [studentId], references: [id])
  chapter  Chapter        @relation(fields: [chapterId], references: [id])
  assigner User           @relation("ChapterAssigner", fields: [assignedBy], references: [id])

  @@unique([studentId, chapterId])
  @@map("chapter_assignments")
}

model Problem {
  id                  String    @id @default(uuid())
  chapterId           String
  subtopicId          String?
  source              String    @default("NCERT")
  sourceReference     String?
  rawText             String
  unknownAnnotation   String
  concreteRestatement String
  givens              Json
  impliedGivens       Json      @default("[]")
  conceptAnchor       String
  problemType         String
  difficultyTier      Int
  requiresSketch      Boolean   @default(false)
  isActive            Boolean   @default(true)
  contentReviewedBy   String?
  contentReviewedAt   DateTime?
  createdAt           DateTime  @default(now())

  chapter             Chapter              @relation(fields: [chapterId], references: [id])
  reviewer            User?                @relation(fields: [contentReviewedBy], references: [id])
  annotations         ProblemAnnotation[]
  sessionInteractions SessionInteraction[]
  sourceDraft         ProblemDraft?
  subtopic            Subtopic?            @relation(fields: [subtopicId], references: [id])
  diagram             ProblemDiagram?
  guidedSolve         GuidedSolveProblem?

  @@index([chapterId])
  @@map("problems")
}

// A single generated visual (Manim-rendered video/gif) explaining a
// Problem, used for visually-dependent chapters (optics, circles,
// mirrors, triangles) where text alone is a real barrier for a
// below-average or simple-English-only student. Kept as its own model
// rather than fields on Problem because it has its own
// generate -> review -> publish lifecycle, mirroring ProblemDraft's
// pattern rather than reusing it directly (the artifact here is a
// rendered video file plus the source scene code that produced it,
// not annotation text).
model ProblemDiagram {
  id             String        @id @default(uuid())
  problemId      String        @unique
  sceneCode      String        // The Manim Python scene source that generated this render, kept for re-render/audit.
  promptVersion  String
  videoUrl       String?       // Set once rendered and uploaded to storage; null while pending render.
  status         DiagramStatus @default(pending_render)
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNotes    String?
  renderErrorMsg String?       // Populated when the Manim render itself fails, distinct from a content/review rejection.
  createdAt      DateTime      @default(now())

  problem  Problem @relation(fields: [problemId], references: [id])
  reviewer User?   @relation(fields: [reviewedBy], references: [id])
  stages   DiagramStage[]

  @@map("problem_diagrams")
}

enum DiagramStatus {
  pending_render
  pending_review
  approved
  rejected
  render_failed
}

model DiagramStage {
  id         String  @id @default(uuid())
  diagramId  String
  stageIndex Int
  videoUrl   String?
  label      String

  diagram ProblemDiagram @relation(fields: [diagramId], references: [id])

  @@unique([diagramId, stageIndex])
  @@map("diagram_stages")
}


model ProblemDraft {
  id                  String      @id @default(uuid())
  chapterId           String
  subtopicId          String?
  rawText             String
  unknownAnnotation   String?
  concreteRestatement String?
  givensDraft         Json?
  impliedGivensDraft  Json?
  conceptAnchor       String?
  problemType         String?
  difficultyTier      Int?
  annotationsDraft    Json?
  generatedByLLM      Boolean     @default(true)
  status              DraftStatus @default(pending_review)
  reviewedBy          String?
  reviewedAt          DateTime?
  reviewNotes         String?
  publishedProblemId  String?     @unique
  createdAt           DateTime    @default(now())

  chapter          Chapter   @relation(fields: [chapterId], references: [id])
  reviewer         User?     @relation(fields: [reviewedBy], references: [id])
  publishedProblem Problem?  @relation(fields: [publishedProblemId], references: [id])
  Subtopic         Subtopic? @relation(fields: [subtopicId], references: [id])

  @@map("problem_drafts")
}

enum DraftStatus {
  pending_review
  approved
  rejected
  needs_revision
}

model ProblemAnnotation {
  id             String         @id @default(uuid())
  problemId      String
  annotationType AnnotationType
  annotationText String
  hintText       String
  label          String?
  sequenceOrder  Int
  createdAt      DateTime       @default(now())

  problem             Problem              @relation(fields: [problemId], references: [id])
  sessionInteractions SessionInteraction[]

  @@unique([problemId, annotationType, sequenceOrder])
  @@map("problem_annotations")
}

enum AnnotationType {
  unknown
  given
  implied_given
  concept_anchor
}

enum FadeAnnotationType {
  unknown
  given
  implied_given
}

model ScaffoldingLevel {
  id                  String   @id @default(uuid())
  studentId           String
  chapterId           String
  currentLevel        Decimal  @default(0.000) @db.Decimal(4, 3)
  problemsAttempted   Int      @default(0)
  problemsClean       Int      @default(0)
  consecutiveClean    Int      @default(0)
  consecutiveFailures Int      @default(0)
  lastUpdatedAt       DateTime @default(now())
  createdAt           DateTime @default(now())

  student StudentProfile           @relation(fields: [studentId], references: [id])
  chapter Chapter                  @relation(fields: [chapterId], references: [id])
  byType  ScaffoldingLevelByType[]

  @@unique([studentId, chapterId])
  @@map("scaffolding_levels")
}

model ScaffoldingLevelByType {
  id                  String             @id @default(uuid())
  scaffoldingLevelId  String
  annotationType      FadeAnnotationType
  level               Decimal            @default(0.000) @db.Decimal(4, 3)
  problemsAttempted   Int                @default(0)
  problemsClean       Int                @default(0)
  consecutiveClean    Int                @default(0)
  consecutiveFailures Int                @default(0)
  lastUpdatedAt       DateTime           @default(now())
  createdAt           DateTime           @default(now())

  scaffoldingLevel ScaffoldingLevel @relation(fields: [scaffoldingLevelId], references: [id])

  @@unique([scaffoldingLevelId, annotationType])
  @@map("scaffolding_levels_by_type")
}

model Session {
  id                    String     @id @default(uuid())
  studentId             String
  chapterId             String
  startedAt             DateTime   @default(now())
  endedAt               DateTime?
  endReason             EndReason?
  problemsPresented     Int        @default(0)
  problemsAttempted     Int        @default(0)
  scaffoldingLevelStart Decimal    @db.Decimal(4, 3)
  scaffoldingLevelEnd   Decimal?   @db.Decimal(4, 3)
  sessionEndStatement   String?
  aiModelUsed           String?
  createdAt             DateTime   @default(now())

  student             StudentProfile       @relation(fields: [studentId], references: [id])
  chapter             Chapter              @relation(fields: [chapterId], references: [id])
  interactions        SessionInteraction[]
  scaffoldingHistory  ScaffoldingHistory[]
  teacherObservations TeacherObservation[]
  aiCalls             AiCall[]

  @@index([studentId, startedAt])
  @@map("sessions")
}

enum EndReason {
  completed
  consecutive_failures
  student_exit
  timeout
  abandonment_predicted
}

model SessionInteraction {
  id                 String          @id @default(uuid())
  sessionId          String
  studentId          String
  problemId          String
  interactionType    InteractionType
  annotationId       String?
  studentResponse    String?
  isCorrect          Boolean?
  scaffoldingLevelAt Decimal         @db.Decimal(4, 3)
  timeOnStepMs       Int?
  comparisonData     Json?
  mode3PromptType    String?
  createdAt          DateTime        @default(now())

  session    Session            @relation(fields: [sessionId], references: [id])
  problem    Problem            @relation(fields: [problemId], references: [id])
  annotation ProblemAnnotation? @relation(fields: [annotationId], references: [id])

  @@index([sessionId, createdAt])
  @@index([studentId, createdAt])
  @@index([studentId, problemId])
  @@map("session_interactions")
}

enum InteractionType {
  annotation_presented
  annotation_selected
  annotation_correct
  annotation_incorrect
  comparison_presented
  comparison_answered
  hint_requested
  hint_shown
  problem_completed
  problem_abandoned
}

model ScaffoldingHistory {
  id          String            @id @default(uuid())
  studentId   String
  chapterId   String
  sessionId   String
  levelBefore Decimal           @db.Decimal(4, 3)
  levelAfter  Decimal           @db.Decimal(4, 3)
  delta       Decimal           @db.Decimal(4, 3)
  reason      ScaffoldingReason
  createdAt   DateTime          @default(now())

  chapter Chapter @relation(fields: [chapterId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@index([studentId, chapterId, createdAt])
  @@map("scaffolding_history")
}

enum ScaffoldingReason {
  correct_answer
  incorrect_answer
  session_end_positive
  session_end_negative
  teacher_override
}

model AiCall {
  id            String     @id @default(uuid())
  callType      AiCallType
  studentId     String?
  sessionId     String?
  problemId     String?
  modelUsed     String
  promptVersion String
  inputTokens   Int?
  outputTokens  Int?
  latencyMs     Int?
  responseText  String?
  wasUsed       Boolean    @default(true)
  createdAt     DateTime   @default(now())

  session Session? @relation(fields: [sessionId], references: [id])

  @@map("ai_calls")
}

enum AiCallType {
  comparison_question
  session_end_statement
  parent_summary
  annotation_draft
  hint_rephrase
  answer_grading
}

model ParentSummary {
  id                              String           @id @default(uuid())
  studentId                       String
  parentId                        String
  weekStartDate                   DateTime
  problemsPresented               Int              @default(0)
  problemsIndependentlyIdentified Int              @default(0)
  scaffoldingLevelStart           Decimal?         @db.Decimal(4, 3)
  scaffoldingLevelEnd             Decimal?         @db.Decimal(4, 3)
  summaryText                     String
  aiCallId                        String?
  deliveredVia                    DeliveryChannel?
  deliveredAt                     DateTime?
  createdAt                       DateTime         @default(now())

  student User @relation("StudentParentSummaries", fields: [studentId], references: [id])
  parent  User @relation("ParentSummaries", fields: [parentId], references: [id])

  @@unique([studentId, weekStartDate])
  @@map("parent_summaries")
}

enum DeliveryChannel {
  whatsapp
  sms
  email
  push
}

model TeacherObservation {
  id          String          @id @default(uuid())
  teacherId   String
  studentId   String
  sessionId   String?
  observation String
  tag         ObservationTag?
  createdAt   DateTime        @default(now())

  teacher User     @relation("TeacherObservations", fields: [teacherId], references: [id])
  student User     @relation("ObservedStudents", fields: [studentId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@map("teacher_observations")
}

enum ObservationTag {
  concept_gap
  language_barrier
  engagement_issue
  ready_to_advance
  needs_intervention
}

// ─── Guided Solve (Path B — adaptive tutor for circle-segment chapter) ────────
// Each Problem can optionally have a GuidedSolveProblem record that breaks it
// into typed steps (concept → substitution → computation). The student works
// through each step with MCQ or numeric input; three wrong answers at a
// computation step surfaces a worked example of a simpler problem.

enum StepType {
  concept      // MCQ — which formula applies?
  substitution // MCQ — what values go into the formula?
  computation  // Numeric — calculate the result
}

enum InputType {
  mcq
  numeric
}

model GuidedSolveProblem {
  id        String      @id @default(uuid())
  problemId String      @unique
  problem   Problem     @relation(fields: [problemId], references: [id])
  steps     SolveStep[]
  createdAt DateTime    @default(now())

  @@map("guided_solve_problems")
}

model SolveStep {
  id                    String             @id @default(uuid())
  guidedSolveProblemId  String
  guidedSolveProblem    GuidedSolveProblem @relation(fields: [guidedSolveProblemId], references: [id])
  sequenceOrder         Int
  stepType              StepType
  stepLabel             String             // e.g. "Step 1 of 7 — Sector Area Formula"
  prompt                String             // The question shown to the student
  inputType             InputType
  correctAnswer         String             // For numeric: decimal string; for MCQ: option text
  tolerance             Float?             // Only used when inputType = numeric (e.g. 0.01)
  hintText              String             // Contextual hint — shown after 1st wrong answer
  hintText2             String?            // Procedural hint — shown after 2nd wrong answer
  hintText3             String?            // Bottom-out hint — shown after 3rd wrong answer
  errorFeedback         String             // Shown immediately on a wrong answer
  formulaCard           String?            // Always-visible formula reference on left panel
  svgStage              Int                // Which SVG stage to show for this step (0-7)
  workedExampleText     String?            // Full worked example shown after 3rd fail
  workedExampleSvgStage Int?               // SVG stage for the worked example panel
  selfExplainPrompt     String?            // Reflection prompt shown after worked example
  selfExplainAnswer     String?            // Model answer for self-explanation
  followUpPrompt        String?            // Follow-up question shown if student rates Somewhat/No
  followUpAnswer        String?            // Correct answer for follow-up (numeric or MCQ text)
  followUpInputType     InputType?         // 'numeric' or 'mcq'
  followUpTolerance     Float?             // Tolerance for numeric follow-up
  options               SolveStepOption[]
  attempts              SolveAttempt[]

  @@unique([guidedSolveProblemId, sequenceOrder])
  @@map("solve_steps")
}

model SolveStepOption {
  id         String    @id @default(uuid())
  stepId     String
  step       SolveStep @relation(fields: [stepId], references: [id])
  optionText String
  isCorrect  Boolean
  orderIndex Int

  @@map("solve_step_options")
}

model SolveAttempt {
  id            String    @id @default(uuid())
  stepId        String
  step          SolveStep @relation(fields: [stepId], references: [id])
  studentId     String
  sessionId     String
  studentAnswer String
  isCorrect     Boolean
  attemptNumber Int
  createdAt     DateTime  @default(now())

  @@index([studentId, stepId, createdAt])
  @@map("solve_attempts")
}
